{
  "name": "pelacord",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Pelacord - a peer-to-peer voice, screen share and chat app. UI design derived from Fluxer (AGPL-3.0-or-later).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/update-loop.test.cjs",
    "electron": "electron .",
    "desktop": "electron .",
    "dist": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/balti4152/pelacord.git"
  },
  "build": {
    "appId": "app.pelacord.desktop",
    "productName": "Pelacord",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "balti4152",
        "repo": "pelacord",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Pelacord"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "emoji-picker-react": "^5.0.0",
    "firebase": "^13.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
